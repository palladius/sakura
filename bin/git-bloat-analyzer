#!/usr/bin/env ruby

require 'json'
require 'fileutils'
require 'cgi'
require 'webrick'

GIT_DIR = ARGV[0] ? File.expand_path(ARGV[0]) : File.expand_path("~/git")
HTML_OUTPUT = "/tmp/git-repos-size-report.html"
PORT = 8989

$repos = []

def format_size(kb)
  if kb > 1024 * 1024
    "%.2f GB" % (kb.to_f / (1024 * 1024))
  elsif kb > 1024
    "%.2f MB" % (kb.to_f / 1024)
  else
    "#{kb} KB"
  end
end

def calculate_repo_size(dir)
  repo_name = File.basename(dir)
  total_kb = `du -sk "#{dir}" 2>/dev/null`.split("\t").first.to_i
  git_kb = `du -sk "#{dir}/.git" 2>/dev/null`.split("\t").first.to_i
  
  tracked_bytes = `git -C "#{dir}" ls-tree -rl HEAD 2>/dev/null | awk '{s+=$4} END {print s}'`.strip.to_i
  tracked_kb = tracked_bytes / 1024

  bloat_kb = total_kb - git_kb - tracked_kb
  bloat_kb = 0 if bloat_kb < 0
  
  total_for_pct = total_kb == 0 ? 1 : total_kb
  bloat_pct = (bloat_kb.to_f / total_for_pct * 100).round(1)

  # Check for clean commands
  clean_cmd = nil
  begin
    if File.exist?("#{dir}/justfile") && File.read("#{dir}/justfile").match?(/^clean:/)
      clean_cmd = "just clean"
    elsif File.exist?("#{dir}/Makefile") && File.read("#{dir}/Makefile").match?(/^clean:/)
      clean_cmd = "make clean"
    end
  rescue => e
    # Ignore read errors
  end
  
  # Get last commit info
  last_commit_ts = `git -C "#{dir}" log -1 --format="%ct" 2>/dev/null`.strip.to_i
  last_commit_date = `git -C "#{dir}" log -1 --format="%cd" --date=short 2>/dev/null`.strip
  last_commit_date = "N/A" if last_commit_date.empty?

  {
    name: repo_name,
    path: dir,
    total_kb: total_kb,
    git_kb: git_kb,
    tracked_kb: tracked_kb,
    bloat_kb: bloat_kb,
    bloat_pct: bloat_pct,
    clean_cmd: clean_cmd,
    last_commit_ts: last_commit_ts,
    last_commit_date: last_commit_date
  }
end

def calculate_all_sizes
  $repos = []
  dirs = Dir.glob("#{GIT_DIR}/*").select { |f| File.directory?(f) && File.directory?("#{f}/.git") }
  puts "🔍 Found #{dirs.size} git repositories in #{GIT_DIR}. Calculating sizes..."

  mutex = Mutex.new
  threads = dirs.map do |dir|
    Thread.new do
      data = calculate_repo_size(dir)
      mutex.synchronize do
        $repos << data
        print "."
        $stdout.flush
      end
    end
  end
  threads.each(&:join)
  puts "\n✅ Done!"
  $repos.sort_by! { |r| -r[:total_kb] }
end

def gather_disk_info
  git_folder_kb = `du -sk "#{GIT_DIR}" 2>/dev/null`.split("\t").first.to_i
  $total_git_kb = git_folder_kb

  $disks = []
  
  git_disk_line = `df -k "#{GIT_DIR}"`.split("\n").last
  parts = git_disk_line.split(/\s+/)
  if parts.length >= 9
    fs = parts[0]
    total_kb = parts[1].to_i
    capacity_pct = parts[4].to_i
    mount = parts[8..-1].join(" ")
    $disks << {name: "🏠 ~", fs: fs, total_kb: total_kb, mount: mount, is_root: true, capacity: capacity_pct}
  end
  
  df_lines = `df -k`.split("\n")[1..-1]
  df_lines.each do |line|
    parts = line.split(/\s+/)
    next if parts.length < 9
    fs = parts[0]
    total_kb = parts[1].to_i
    capacity_pct = parts[4].to_i
    mount = parts[8..-1].join(" ")
    
    if existing_disk = $disks.find { |d| d[:fs] == fs || d[:total_kb] == total_kb }
      existing_disk[:capacity] = capacity_pct if mount == "/"
      next
    end
    next unless fs.start_with?("/dev/")
    next if mount.match?(%r{^/System/Volumes/(VM|Preboot|Update|xarts|iSCPreboot|Hardware)$})
    next if total_kb < 50 * 1024 * 1024 # Only > 50GB
    
    $disks << {name: mount == "/" ? "🌱 /" : "💿 #{File.basename(mount)}", fs: fs, total_kb: total_kb, mount: mount, is_root: false, capacity: capacity_pct}
  end
end

def gather_trash_info
  trash_kb = `du -sk ~/.Trash 2>/dev/null`.split("\t").first.to_i
  $trash_kb = trash_kb
end

def generate_disk_html
  total_bloat_kb = $repos.sum { |r| r[:bloat_kb] }
  root_disk = $disks.find { |d| d[:is_root] } || $disks.first || {total_kb: 100000000000}
  trash_pct = $trash_kb ? ($trash_kb.to_f / root_disk[:total_kb] * 100).round(1) : 0
  has_actions = $trash_kb && (trash_pct >= 1.0 || $trash_kb > 1024 * 1024)
  action_html = has_actions ? "<a href='/empty-trash' class='clean-btn action' onclick='this.innerText=\"Emptying...\";' style='padding: 4px 8px; font-size: 0.8em;'>Empty Trash</a>" : ""

  html = <<-HTML
    <table id="diskTable" style="min-width: 400px; margin-top: 0; font-size: 0.85em;">
      <thead>
        <tr>
          <th onclick="sortTable('diskTable', 0, 'string')" style="padding: 8px;">Disk <span class="sort-icon">↕</span></th>
          <th style="padding: 8px;">Usage</th>
          <th onclick="sortTable('diskTable', 2, 'number')" style="padding: 8px; text-align: right;">Git Size <span class="sort-icon">↕</span></th>
          <th onclick="sortTable('diskTable', 3, 'number')" style="padding: 8px; text-align: right;">Total <span class="sort-icon">↕</span></th>
          <th onclick="sortTable('diskTable', 4, 'number')" style="padding: 8px; text-align: right;">% Used <span class="sort-icon">↕</span></th>
          #{has_actions ? '<th style="padding: 8px;">Actions</th>' : ''}
        </tr>
      </thead>
      <tbody>
  HTML

  $disks.each do |disk|
    is_root = disk[:is_root]
    name = disk[:name]
    capacity = disk[:capacity]
    git_pct = is_root ? ($total_git_kb.to_f / disk[:total_kb] * 100).round(1) : 0
    pct_color = (capacity < 50 || capacity > 85) ? "#ef4444" : "#94a3b8"
    
    if is_root
      other_used_pct = [capacity - git_pct, 0].max
      bloat_pct = (total_bloat_kb.to_f / disk[:total_kb] * 100).round(1)
      clean_git_pct = [git_pct - bloat_pct, 0].max
      html += <<-ROW
        <tr>
          <td data-value="#{name}"><strong>#{name}</strong></td>
          <td style="width: 100px;">
            <div class="disk-bar-container" style="background: #475569; border-radius: 6px; height: 12px; overflow: hidden; display: flex; width: 100%;" title="Used: #{capacity}%">
              <div class="disk-bar-git" style="width: #{capacity}%; background: #3b82f6; height: 100%;"></div>
            </div>
          </td>
          <td data-value="0" style="text-align: right;">-</td>
          <td data-value="#{disk[:total_kb]}" style="text-align: right;">#{format_size(disk[:total_kb])}</td>
          <td data-value="#{capacity}" style="color:#{pct_color}; text-align: right;">#{capacity}%</td>
          #{has_actions ? '<td></td>' : ''}
        </tr>
        <tr style="background: rgba(0,0,0,0.15);">
          <td data-value="Git" style="padding-left: 25px;">↳ 👨‍💻 Git Repos</td>
          <td style="width: 100px;">
            <div class="disk-bar-container" style="background: #475569; border-radius: 6px; height: 12px; overflow: hidden; display: flex; width: 100%;" title="Git: #{git_pct}% | Other Used: #{other_used_pct}%">
              <div class="disk-bar-git" style="width: #{git_pct}%; background: #22c55e; height: 100%;"></div>
              <div class="disk-bar-other" style="width: #{other_used_pct}%; background: #3b82f6; height: 100%; opacity: 0.5;"></div>
            </div>
          </td>
          <td data-value="#{$total_git_kb}" style="text-align: right; color: #22c55e;">#{format_size($total_git_kb)}</td>
          <td data-value="0" style="text-align: right;">-</td>
          <td data-value="#{git_pct}" style="text-align: right; color: #22c55e;">#{git_pct}%</td>
          #{has_actions ? '<td></td>' : ''}
        </tr>
        <tr style="background: rgba(0,0,0,0.25);">
          <td data-value="Bloat" style="padding-left: 45px; font-size: 0.9em;">↳ 🦠 Git Bloat</td>
          <td style="width: 100px;">
            <div class="disk-bar-container" style="background: #475569; border-radius: 6px; height: 12px; overflow: hidden; display: flex; width: 100%;" title="Clean Git: #{clean_git_pct}% | Bloat: #{bloat_pct}% | Other Used: #{other_used_pct}%">
              <div class="disk-bar-git" style="width: #{clean_git_pct}%; background: #22c55e; height: 100%;"></div>
              <div class="disk-bar-bloat" style="width: #{bloat_pct}%; background: #ef4444; height: 100%;"></div>
              <div class="disk-bar-other" style="width: #{other_used_pct}%; background: #3b82f6; height: 100%; opacity: 0.5;"></div>
            </div>
          </td>
          <td data-value="#{total_bloat_kb}" style="text-align: right; color: #ef4444;">#{format_size(total_bloat_kb)}</td>
          <td data-value="0" style="text-align: right;">-</td>
          <td data-value="#{bloat_pct}" style="text-align: right; color: #ef4444;">#{bloat_pct}%</td>
          #{has_actions ? '<td></td>' : ''}
        </tr>
      ROW
    else
      html += <<-ROW
        <tr>
          <td data-value="#{name}"><strong>#{name}</strong></td>
          <td style="width: 100px;">
            <div class="disk-bar-container" style="background: #475569; border-radius: 6px; height: 12px; overflow: hidden; display: flex; width: 100%;" title="Used: #{capacity}%">
              <div class="disk-bar-git" style="width: #{capacity}%; background: #3b82f6; height: 100%;"></div>
            </div>
          </td>
          <td data-value="0" style="text-align: right;">-</td>
          <td data-value="#{disk[:total_kb]}" style="text-align: right;">#{format_size(disk[:total_kb])}</td>
          <td data-value="#{capacity}" style="color:#{pct_color}; text-align: right;">#{capacity}%</td>
          #{has_actions ? '<td></td>' : ''}
        </tr>
      ROW
    end
  end
  
  if $trash_kb
    html += <<-ROW
        <tr>
          <td data-value="Trash"><strong>🗑️ Trash</strong></td>
          <td></td>
          <td data-value="#{$trash_kb}" style="text-align: right;">#{format_size($trash_kb)}</td>
          <td data-value="0" style="text-align: right;">-</td>
          <td data-value="#{trash_pct}" style="text-align: right;">#{trash_pct}%</td>
          #{has_actions ? "<td>#{action_html}</td>" : ""}
        </tr>
    ROW
  end

  html += "</tbody></table>"
  html
end

def generate_html
  html = <<-HTML
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Git Repositories Size Report</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-color: #0f172a;
            --text-color: #f8fafc;
            --card-bg: rgba(30, 41, 59, 0.7);
            --border-color: rgba(255, 255, 255, 0.1);
            --accent-color: #38bdf8;
            --hover-color: rgba(56, 189, 248, 0.1);
            --btn-bg: #475569;
            --btn-hover: #334155;
        }
        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            margin: 0;
